<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FDFCFC" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F8F7F7" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#F1EEEE" />
    <SolidColorBrush x:Key="InkBrush" Color="#201D1D" />
    <SolidColorBrush x:Key="InkHoverBrush" Color="#302C2C" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="#646262" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9A9898" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#E3E1E1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F8FAC7" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#201D1D" />
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#C7FAC7" />
    <SolidColorBrush x:Key="GreenBrush" Color="#03B000" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
    <SolidColorBrush x:Key="OnInkBrush" Color="#FDFCFC" />

</ResourceDictionary>