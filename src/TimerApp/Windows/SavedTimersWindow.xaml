<Window x:Class="TimerApp.Windows.SavedTimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_SavedTimersTitle}"
        Width="300"
        SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MonoFont}">

    <Window.Resources>
        <!-- Red cross button (close / delete row) -->
        <Style x:Key="CrossButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <Path Data="M0,0 L8,8 M8,0 L0,8"
                                  Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                                  Stretch="Uniform" Width="9" Height="9"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid>
                <TextBlock Text="{DynamicResource L_SavedTimersTitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Style="{StaticResource CrossButtonStyle}"
                        HorizontalAlignment="Right" Click="OnCloseClick" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,8,0,10" />

            <TextBlock x:Name="EmptyHint"
                       Text="{DynamicResource L_EmptySaved}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="13" Margin="4,8"
                       Visibility="Collapsed" />

            <ListBox x:Name="List" MaxHeight="340" Background="Transparent"
                     BorderThickness="0" Padding="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <!-- Footer -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="FooterLeft" Orientation="Horizontal" />
                <StackPanel x:Name="FooterRight" Grid.Column="1" Orientation="Horizontal" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
