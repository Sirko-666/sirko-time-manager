<Window x:Class="TimerApp.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource MonoFont}">

    <Border x:Name="Body"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14" Cursor="Hand"
            MouseLeftButtonUp="OnBodyClick">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="3" CornerRadius="2"
                    Background="{DynamicResource AccentBrush}"
                    HorizontalAlignment="Left" Margin="0,2,12,2" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Text="STM"
                           Foreground="{DynamicResource InkBrush}"
                           FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText"
                           Foreground="{DynamicResource BodyTextBrush}"
                           FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
