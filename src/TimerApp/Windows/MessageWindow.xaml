<Window x:Class="TimerApp.Windows.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MonoFont}">

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13" VerticalAlignment="Center" />
                <Button Style="{StaticResource CrossButtonStyle}"
                        HorizontalAlignment="Right" Click="OnCloseClick" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,8,0,12" />

            <TextBlock x:Name="MessageText"
                       Foreground="{DynamicResource InkBrush}"
                       FontSize="14" TextWrapping="Wrap" MaxWidth="280" />

            <Button Content="{DynamicResource L_Done}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Right" Margin="0,16,0,0"
                    Click="OnCloseClick" />
        </StackPanel>
    </Border>
</Window>
