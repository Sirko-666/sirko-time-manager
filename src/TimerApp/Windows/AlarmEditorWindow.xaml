<Window x:Class="TimerApp.Windows.AlarmEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:TimerApp.Controls"
        Title="{DynamicResource L_EditAlarm}"
        Width="340"
        SizeToContent="Height" MaxHeight="640"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MonoFont}">

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid>
                <TextBlock x:Name="HeaderText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13" VerticalAlignment="Center" />
                <Button Style="{StaticResource CrossButtonStyle}"
                        HorizontalAlignment="Right" Click="OnCancelClick" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,8,0,12" />

            <!-- Time -->
            <ctrl:TimeDial x:Name="Dial" LargeMode="True" HorizontalAlignment="Center" />

            <!-- Repeat -->
            <Grid Margin="2,16,0,8">
                <TextBlock Text="{DynamicResource L_AlarmRepeat}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12" VerticalAlignment="Center" />
                <ToggleButton x:Name="OnceToggle" Content="{DynamicResource L_DaysOnce}"
                              Style="{StaticResource DayToggleStyle}"
                              HorizontalAlignment="Right"
                              Checked="OnOnceChanged" Unchecked="OnOnceChanged" />
            </Grid>
            <UniformGrid x:Name="WeekdayGrid" Rows="1" Columns="7">
                <ToggleButton x:Name="Day0" Style="{StaticResource DayToggleStyle}" Content="{DynamicResource L_DayMon}" Margin="0,0,4,0" Checked="OnDayChanged" Unchecked="OnDayChanged" />
                <ToggleButton x:Name="Day1" Style="{StaticResource DayToggleStyle}" Content="{DynamicResource L_DayTue}" Margin="0,0,4,0" Checked="OnDayChanged" Unchecked="OnDayChanged" />
                <ToggleButton x:Name="Day2" Style="{StaticResource DayToggleStyle}" Content="{DynamicResource L_DayWed}" Margin="0,0,4,0" Checked="OnDayChanged" Unchecked="OnDayChanged" />
                <ToggleButton x:Name="Day3" Style="{StaticResource DayToggleStyle}" Content="{DynamicResource L_DayThu}" Margin="0,0,4,0" Checked="OnDayChanged" Unchecked="OnDayChanged" />
                <ToggleButton x:Name="Day4" Style="{StaticResource DayToggleStyle}" Content="{DynamicResource L_DayFri}" Margin="0,0,4,0" Checked="OnDayChanged" Unchecked="OnDayChanged" />
                <ToggleButton x:Name="Day5" Style="{StaticResource DayToggleStyle}" Content="{DynamicResource L_DaySat}" Margin="0,0,4,0" Checked="OnDayChanged" Unchecked="OnDayChanged" />
                <ToggleButton x:Name="Day6" Style="{StaticResource DayToggleStyle}" Content="{DynamicResource L_DaySun}" Checked="OnDayChanged" Unchecked="OnDayChanged" />
            </UniformGrid>

            <!-- Cyclic repeat -->
            <Grid Margin="2,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="CycleSwitch" Grid.Column="0"
                              Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                              Checked="OnCycleSwitchChanged" Unchecked="OnCycleSwitchChanged" />
                <TextBlock Grid.Column="1" Text="{DynamicResource L_AlarmCycle}"
                           Foreground="{DynamicResource InkBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="10,0,8,0" />
                <Button x:Name="CycleButton" Grid.Column="2" Content="5/2"
                        Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Center"
                        Click="OnCycleButtonClick" />
            </Grid>

            <!-- Label -->
            <TextBlock Text="{DynamicResource L_AlarmLabel}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12" Margin="2,16,0,8" />
            <TextBox x:Name="LabelBox" Style="{StaticResource InputStyle}" MaxLength="40" />

            <!-- Actions -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Content="{DynamicResource L_Delete}"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left" Click="OnDeleteClick" />
                <Button Grid.Column="1" Content="{DynamicResource L_AlarmSave}"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
