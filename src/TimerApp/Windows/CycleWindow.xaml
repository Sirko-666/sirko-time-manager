<Window x:Class="TimerApp.Windows.CycleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:TimerApp.Controls"
        Title="{DynamicResource L_CycleTitle}"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MonoFont}">

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid>
                <TextBlock Text="{DynamicResource L_CycleTitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13" VerticalAlignment="Center" />
                <Button Style="{StaticResource CrossButtonStyle}"
                        HorizontalAlignment="Right" Click="OnCancelClick" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,8,0,12" />

            <!-- Work / rest wheels -->
            <ctrl:CycleDial x:Name="Wheel" HorizontalAlignment="Center"
                            LeftMin="1" LeftMax="30" RightMin="0" RightMax="30" />
            <Grid Width="152" HorizontalAlignment="Center" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource L_CycleWork}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource L_CycleRest}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                           HorizontalAlignment="Center" />
            </Grid>

            <!-- Start date -->
            <TextBlock Text="{DynamicResource L_CycleStart}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12" Margin="2,16,0,8" />
            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4"
                    HorizontalAlignment="Center" Padding="2">
                <Calendar x:Name="StartCalendar" BorderThickness="0"
                          Background="{DynamicResource PanelBrush}"
                          SelectionMode="SingleDate"
                          SelectedDatesChanged="OnDateChanged" />
            </Border>

            <TextBlock x:Name="PreviewText"
                       Foreground="{DynamicResource BodyTextBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="2,10,0,0" />

            <!-- Actions -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource L_Cancel}"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left" Click="OnCancelClick" />
                <Button Grid.Column="1" Content="{DynamicResource L_AlarmSave}"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
