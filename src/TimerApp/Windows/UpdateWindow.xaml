<Window x:Class="TimerApp.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_UpdateWindowTitle}"
        Width="380" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MonoFont}">

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock Text="{DynamicResource L_UpdateWindowTitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13" VerticalAlignment="Center" />
                <Button Style="{StaticResource CrossButtonStyle}"
                        HorizontalAlignment="Right" Click="OnCancelClick" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,8,0,12" />

            <TextBlock x:Name="VersionText"
                       Foreground="{DynamicResource InkBrush}"
                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />

            <TextBlock Text="{DynamicResource L_UpdateNotesTitle}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12" Margin="0,14,0,6" />

            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText"
                               Foreground="{DynamicResource BodyTextBrush}"
                               FontSize="13" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource L_UpdateSkip}"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left" Click="OnSkipClick" />
                <Button Grid.Column="2" Content="{DynamicResource L_UpdateNow}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" Click="OnUpdateClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
