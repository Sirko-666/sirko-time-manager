<Window x:Class="TimerApp.Windows.UpdateChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_UpdateChoiceTitle}"
        Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MonoFont}">

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock Text="{DynamicResource L_UpdateChoiceTitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13" VerticalAlignment="Center" />
                <Button Style="{StaticResource CrossButtonStyle}"
                        HorizontalAlignment="Right" Click="OnCancelClick" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,8,0,12" />

            <TextBlock Text="{DynamicResource L_UpdateChoiceText}"
                       Foreground="{DynamicResource BodyTextBrush}"
                       FontSize="13" TextWrapping="Wrap" />

            <Button Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalContentAlignment="Left" Margin="0,14,0,0"
                    Click="OnFattyClick">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L_UpdateFattyName}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L_UpdateFattyDesc}"
                               FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource GhostButtonStyle}"
                    HorizontalContentAlignment="Left" Margin="0,8,0,0"
                    Click="OnMiniClick">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L_UpdateMiniName}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L_UpdateMiniDesc}"
                               FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Button>

            <Button Content="{DynamicResource L_UpdateGetRuntime}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Left" Margin="0,12,0,0"
                    FontSize="12" Click="OnRuntimeClick" />
        </StackPanel>
    </Border>
</Window>
