<Window x:Class="TimerApp.Windows.SoundPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_AlarmSoundTitle}"
        Width="300"
        SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MonoFont}">

    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid>
                <TextBlock Text="{DynamicResource L_AlarmSoundTitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13" VerticalAlignment="Center" />
                <Button Style="{StaticResource CrossButtonStyle}"
                        HorizontalAlignment="Right" Click="OnCancelClick" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,8,0,8" />

            <Button Content="{DynamicResource L_AddSound}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Left" Margin="2,0,0,10"
                    Click="OnAddSoundClick" />

            <ListBox x:Name="List" MaxHeight="340" Background="Transparent"
                     BorderThickness="0" Padding="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged" />

            <!-- Footer -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource L_Cancel}"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="0,0,8,0" Click="OnCancelClick" />
                    <Button Content="{DynamicResource L_Apply}"
                            Style="{StaticResource PrimaryButtonStyle}" Click="OnApplyClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>

