<Window x:Class="TimerApp.Windows.AlarmRingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_AlarmRingTitle}"
        Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="True"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource MonoFont}">

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.22" Color="#000000" />
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{DynamicResource L_AlarmRingTitle}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="13" HorizontalAlignment="Center" />
            <TextBlock x:Name="TimeText"
                       Foreground="{DynamicResource InkBrush}"
                       FontSize="48" FontWeight="Bold" Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="LabelText"
                       Foreground="{DynamicResource BodyTextBrush}"
                       FontSize="14" Margin="0,4,0,0"
                       HorizontalAlignment="Center" />
            <Button Content="{DynamicResource L_Stop}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Click="OnStopClick" />
        </StackPanel>
    </Border>
</Window>
