<Window x:Class="StmInstaller.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Встановлення STM — Sirko Time Manager"
        Width="560" Height="440"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource MonoFont}">

    <Window.Resources>
        <!-- Step pill -->
        <Style x:Key="StepPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="MockCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,6,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.24" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <!-- Step strip -->
                <Grid Grid.Row="0" Margin="20,16,20,12">
                    <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" VerticalAlignment="Bottom" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border x:Name="Step1Pill" Style="{StaticResource StepPillStyle}">
                            <TextBlock x:Name="Step1Text" Foreground="{DynamicResource InkBrush}" FontSize="12" />
                        </Border>
                        <Border x:Name="Step2Pill" Style="{StaticResource StepPillStyle}" Margin="8,0,0,0">
                            <TextBlock x:Name="Step2Text" Foreground="{DynamicResource InkBrush}" FontSize="12" />
                        </Border>
                        <Border x:Name="Step3Pill" Style="{StaticResource StepPillStyle}" Margin="8,0,0,0">
                            <TextBlock x:Name="Step3Text" Foreground="{DynamicResource InkBrush}" FontSize="12" />
                        </Border>
                        <Border x:Name="Step4Pill" Style="{StaticResource StepPillStyle}" Margin="8,0,0,0">
                            <TextBlock x:Name="Step4Text" Foreground="{DynamicResource InkBrush}" FontSize="12" />
                        </Border>
                    </StackPanel>
                    <Button Content="{DynamicResource L_Cancel}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="OnCancelClick" />
                </Grid>

            <!-- Pages -->
            <Grid Grid.Row="1" Margin="34,10,34,8">

                <!-- Page 1: welcome -->
                <StackPanel x:Name="PageWelcome" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="icon.png" Width="84" Height="84" HorizontalAlignment="Center" />
                    <TextBlock Text="Sirko Time Manager"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="STM · версія 0.1 · розробник: Serhii Sirenko (Sirko)"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L_InstallerIntro}"
                               Foreground="{DynamicResource BodyTextBrush}"
                               FontSize="13" Margin="0,14,0,0" HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <RadioButton x:Name="LangUk" GroupName="Lang"
                                     Style="{StaticResource ModeToggleStyle}"
                                     Content="Українська" Checked="OnLanguageChecked" />
                        <RadioButton x:Name="LangEn" GroupName="Lang"
                                     Style="{StaticResource ModeToggleStyle}"
                                     Content="English" Margin="8,0,0,0" Checked="OnLanguageChecked" />
                        <RadioButton x:Name="LangRu" GroupName="Lang"
                                     Style="{StaticResource ModeToggleStyle}"
                                     Content="Русский" Margin="8,0,0,0" Checked="OnLanguageChecked" />
                    </StackPanel>
                </StackPanel>

                <!-- Page 2: path -->
                <StackPanel x:Name="PagePath" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_ChooseInstallDir}"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="15" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Style="{StaticResource InputStyle}" Width="300" />
                        <Button Grid.Column="1" Content="{DynamicResource L_Browse}"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="8,0,0,0" Click="OnBrowseClick" />
                    </Grid>
                    <TextBlock x:Name="SpaceHint"
                               Text="{DynamicResource L_SizeHint}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" Margin="2,10,0,0" />
                </StackPanel>

                <!-- Page 3: options (switches, same style as the app) -->
                <StackPanel x:Name="PageOptions" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_OptionsTitle}"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="15" FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Margin="4,16,0,0">
                        <ToggleButton x:Name="OptDesktopSwitch"
                                      Style="{StaticResource SwitchStyle}"
                                      IsChecked="True" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L_OptDesktop}"
                                   Foreground="{DynamicResource InkBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="4,12,0,0">
                        <ToggleButton x:Name="OptStartMenuSwitch"
                                      Style="{StaticResource SwitchStyle}"
                                      IsChecked="True" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L_OptStartMenu}"
                                   Foreground="{DynamicResource InkBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="4,12,0,0">
                        <ToggleButton x:Name="OptAutostartSwitch"
                                      Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L_OptAutostart}"
                                   Foreground="{DynamicResource InkBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource L_OptionsHint}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="4,18,0,0" />
                </StackPanel>

                <!-- Page 4: progress -->
                <StackPanel x:Name="PageInstall" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_Installing}"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="15" FontWeight="SemiBold" />
                    <ProgressBar x:Name="InstallBar" Height="10" Margin="0,14,0,10"
                                 Background="{DynamicResource PanelHoverBrush}"
                                 Foreground="#CCFFCC" BorderThickness="0" Value="0" />
                    <TextBlock x:Name="InstallLog"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Page 5: done -->
                <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_DoneTitle}"
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L_DoneText}"
                               Foreground="{DynamicResource BodyTextBrush}"
                               FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Center">
                        <ToggleButton x:Name="OptRunNowSwitch"
                                      Style="{StaticResource SwitchStyle}"
                                      IsChecked="True" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L_RunNow}"
                                   Foreground="{DynamicResource InkBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="20,0,20,16">
                <Button Content="{DynamicResource L_Cancel}"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left" Click="OnCancelClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="{DynamicResource L_Back}"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnBackClick" />
                    <Button x:Name="NextButton" Content="{DynamicResource L_InstallerStart}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0" Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

