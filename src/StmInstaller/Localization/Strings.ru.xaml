    <sys:String x:Key="L_WaitFiles">Завершение файловых операций…</sys:String>
    <sys:String x:Key="L_InstallOk">Установка завершена успешно.</sys:String>
    <sys:String x:Key="L_InstallFailed">Ошибка установки: {0}</sys:String>
    <sys:String x:Key="L_NoExe">TimerApp.exe не найден в пакете установки.</sys:String>
    <sys:String x:Key="L_InvalidDir">Укажите папку для установки.</sys:String>
    <sys:String x:Key="L_Retry">Попробовать ещё раз</sys:String>
    <sys:String x:Key="L_NoRights">Нет прав записи в эту папку.</sys:String>

    <sys:String x:Key="L_DoneTitle">Готово!</sys:String>
