    <sys:String x:Key="L_OptionsHint">Все параметры можно изменить позже в «Настройках» приложения.</sys:String>

    <sys:String x:Key="L_Installing">Установка…</sys:String>
    <sys:String x:Key="L_LogCopy">Копирование файлов…</sys:String>
