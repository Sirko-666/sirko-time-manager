<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="L_InstallerTitle">Установка STM — Sirko Time Manager</sys:String>
    <sys:String x:Key="L_Step1">Приветствие</sys:String>
    <sys:String x:Key="L_Step2">Путь</sys:String>
    <sys:String x:Key="L_Step3">Опции</sys:String>
    <sys:String x:Key="L_Step4">Установка</sys:String>

    <sys:String x:Key="L_InstallerStart">Начать</sys:String>
    <sys:String x:Key="L_Next">Далее</sys:String>
    <sys:String x:Key="L_Back">Назад</sys:String>
    <sys:String x:Key="L_Cancel">Отменить</sys:String>
    <sys:String x:Key="L_InstallNow">Установить</sys:String>
    <sys:String x:Key="L_InstallerFinish">Завершить</sys:String>
    <sys:String x:Key="L_Browse">Обзор…</sys:String>

    <sys:String x:Key="L_InstallerIntro">Этот мастер установит STM на ваш ПК.</sys:String>
    <sys:String x:Key="L_ChooseInstallDir">Куда установить</sys:String>
    <sys:String x:Key="L_SizeHint">Размер пакета ≈ 15 МБ</sys:String>
    <sys:String x:Key="L_BrowseTitle">Выберите папку для установки</sys:String>

    <sys:String x:Key="L_OptionsTitle">Параметры установки</sys:String>
