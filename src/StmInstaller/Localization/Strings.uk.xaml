    <sys:String x:Key="L_Step4">Встановлення</sys:String>

    <sys:String x:Key="L_InstallerStart">Почати</sys:String>
    <sys:String x:Key="L_Next">Далі</sys:String>
    <sys:String x:Key="L_Back">Назад</sys:String>
    <sys:String x:Key="L_Cancel">Скасувати</sys:String>
    <sys:String x:Key="L_InstallNow">Встановити</sys:String>
    <sys:String x:Key="L_InstallerFinish">Завершити</sys:String>
    <sys:String x:Key="L_Browse">Огляд…</sys:String>

