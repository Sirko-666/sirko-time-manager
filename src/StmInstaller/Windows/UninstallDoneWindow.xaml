<Window x:Class="StmInstaller.Windows.UninstallDoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STM"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="#90000000"
        ShowInTaskbar="False" Topmost="True"
        WindowState="Maximized"
        FontFamily="{StaticResource MonoFont}">

    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="10" Padding="30"
            Width="420" Height="230"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.24" Color="#000000" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/icon.png" Width="64" Height="64" HorizontalAlignment="Center" />
            <TextBlock x:Name="TitleText" Text="STM"
                       Foreground="{DynamicResource InkBrush}"
                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="MessageText"
                       Foreground="{DynamicResource BodyTextBrush}"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="✕"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock x:Name="SubText"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
    </Border>
</Window>
